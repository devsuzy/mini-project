# ─────────────────────────────────────────────────────
# 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   그 다음 .env 안의 값을 실제 값으로 채운다
#
# 이 파일(.env.example)은 "어떤 변수가 필요한지" 알려주는 용도라
# 커밋해도 되지만, 실제 값이 든 .env 는 커밋되지 않는다(.gitignore).
# 여기에는 절대 진짜 키를 적지 말 것.
# ─────────────────────────────────────────────────────

# ── 서버 ──────────────────────────────────────────────
PORT=5178
NODE_ENV=development

# ── 로컬 LLM (Ollama) ─────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# ── 외부 API 키 (쓰는 것만 주석 해제) ─────────────────
# ANTHROPIC_API_KEY=sk-ant-여기에-키
# OPENAI_API_KEY=sk-여기에-키

# ── DB (쓴다면) ───────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/mini_program

# ── 환경변수 (절대 커밋 금지) ──────────────────────────
# .env.example 만 커밋하고, 실제 값이 든 파일은 모두 제외한다
.env
.env.*
!.env.example

# ── 실제 카톡 대화 (절대 커밋 금지) ───────────────────────
# 남의 대화 내용이다. 커밋되면 되돌릴 수 없다.
# 개발·테스트에는 허구 데이터인 sample-chat.csv 를 쓴다.
KakaoTalk_Chat_*
*카카오톡*.csv
*카카오톡*.txt
chat-*.csv
!sample-chat.csv

# ── 의존성 ────────────────────────────────────────────
node_modules/
.npm/
.pnp
.pnp.js

# ── 빌드 결과물 ───────────────────────────────────────
dist/
build/
out/
.next/
.cache/
*.tsbuildinfo

# ── 로그 / 임시 파일 ──────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed
tmp/
temp/

# ── 테스트 / 커버리지 ─────────────────────────────────
coverage/
.nyc_output/

# ── macOS ─────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── 에디터 / IDE ──────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ── 기타 ──────────────────────────────────────────────
*.local
.vercel
